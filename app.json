{
  "expo": {
    "name": "Volley Trainer",
    "slug": "volleybuild-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "volleybuildandroid",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.volleytrainer.app"
    },
    "web": {
      "output": "static",
      "name": "CourtReady",
      "shortName": "CourtReady",
      "description": "Jouw persoonlijke volleybal trainingsapp",
      "themeColor": "#1E3A8A",
      "backgroundColor": "#1E3A8A",
      "display": "standalone",
      "startUrl": "/volley-trainer/",
      "lang": "nl"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/volley-trainer"
    }
  }
}
